{{$n := .Name}}
// Test{{$n}}FromInt64 proves a database-assigned identifier is accepted and
// that the values no sequence ever hands out are not.
func Test{{$n}}FromInt64(t *testing.T) {
	t.Parallel()

	// Arrange
	cases := []struct {
		name    string
		in      int64
		wantErr bool
	}{
		{name: "accepts the first identifier a sequence hands out", in: 1},
		{name: "accepts a large identifier", in: 9007199254740993},
		{name: "rejects zero, which is the unassigned identifier", in: 0, wantErr: true},
		{name: "rejects a negative identifier", in: -1, wantErr: true},
	}

	for _, tc := range cases {
		t.Run(tc.name, func(t *testing.T) {
			t.Parallel()

			// Act
			got, err := {{$n}}FromInt64(tc.in)

			// Assert
			if tc.wantErr {
				require.Error(t, err)
				assert.ErrorIs(t, err, vogue.FieldError{Field: {{q .Field}}, Rule: "positive"})
				assert.True(t, got.IsZero())
				return
			}
			require.NoError(t, err)
			assert.Equal(t, tc.in, got.Int64())
			assert.False(t, got.IsZero())
		})
	}
}

// TestParse{{$n}} covers the textual entry point of the identifier.
func TestParse{{$n}}(t *testing.T) {
	t.Parallel()

	t.Run("reads a base-10 identifier", func(t *testing.T) {
		t.Parallel()

		// Act
		got, err := Parse{{$n}}("42")

		// Assert
		require.NoError(t, err)
		assert.Equal(t, int64(42), got.Int64())
	})

	t.Run("rejects a representation that is not a whole number", func(t *testing.T) {
		t.Parallel()

		// Act
		got, err := Parse{{$n}}("not-a-number")

		// Assert
		require.Error(t, err)
		assert.ErrorIs(t, err, vogue.FieldError{Field: {{q .Field}}, Rule: "int"})
		assert.True(t, got.IsZero())
	})

	t.Run("rejects an identifier no sequence hands out", func(t *testing.T) {
		t.Parallel()

		// Act
		got, err := Parse{{$n}}("0")

		// Assert
		require.Error(t, err)
		assert.ErrorIs(t, err, vogue.FieldError{Field: {{q .Field}}, Rule: "positive"})
		assert.True(t, got.IsZero())
	})
}

// Test{{$n}}_RoundTrip proves an identifier survives the text codec and the
// database unchanged. It crosses JSON as a string, so a JavaScript client
// cannot round it off.
func Test{{$n}}_RoundTrip(t *testing.T) {
	t.Parallel()

	// Arrange
	want, err := {{$n}}FromInt64(9007199254740993)
	require.NoError(t, err)

	// Act
	text, err := want.MarshalText()
	require.NoError(t, err)

	var fromText {{$n}}
	require.NoError(t, fromText.UnmarshalText(text))

	stored, err := want.Value()
	require.NoError(t, err)

	var fromSQL {{$n}}
	err = fromSQL.Scan(stored)

	// Assert
	require.NoError(t, err)
	assert.Equal(t, "9007199254740993", string(text))
	assert.True(t, want.Equal(fromText))
	assert.True(t, want.Equal(fromSQL))
}

// Test{{$n}}_Scan covers the sources Scan accepts and the ones it refuses.
func Test{{$n}}_Scan(t *testing.T) {
	t.Parallel()

	t.Run("a NULL column produces the unassigned identifier", func(t *testing.T) {
		t.Parallel()

		// Arrange
		var got {{$n}}

		// Act
		err := got.Scan(nil)

		// Assert
		require.NoError(t, err)
		assert.True(t, got.IsZero())
	})

	t.Run("a stored identifier that is not positive is refused", func(t *testing.T) {
		t.Parallel()

		// Arrange
		var got {{$n}}

		// Act
		err := got.Scan(int64(0))

		// Assert
		require.Error(t, err)
		assert.True(t, got.IsZero())
	})

	t.Run("an unsupported source is refused", func(t *testing.T) {
		t.Parallel()

		// Arrange
		var got {{$n}}

		// Act
		err := got.Scan(struct{}{})

		// Assert
		require.Error(t, err)
		assert.Contains(t, err.Error(), "cannot scan")
	})
}

// Test{{$n}}_IsZero separates an unassigned identifier from an assigned one.
func Test{{$n}}_IsZero(t *testing.T) {
	t.Parallel()

	// Arrange
	var zero {{$n}}
	assigned, err := {{$n}}FromInt64(1)
	require.NoError(t, err)

	// Act & Assert
	assert.True(t, zero.IsZero())
	assert.Equal(t, "0", zero.String())
	assert.False(t, assigned.IsZero())
	assert.False(t, zero.Equal(assigned))
}
