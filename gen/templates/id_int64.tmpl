{{$n := .Name}}{{$r := .Recv}}
{{range .DocLines}}// {{.}}
{{end}}//
// The database assigns the value, so this type has no generator: read it from a
// row or a payload, or wrap a number with New{{$n}}FromInt64.
{{- if .SQL}}
//
//nolint:recvcheck // Scan implements sql.Scanner and needs a pointer receiver.
{{- end}}
type {{$n}} struct{ value int64 }

// New{{$n}}FromInt64 wraps a database-assigned identifier, which is positive.
func New{{$n}}FromInt64(raw int64) ({{$n}}, error) {
	if raw <= 0 {
		var failures {{.Failures}}
		failures.Add({{q .Field}}, "positive", "must be a positive identifier")

		return {{$n}}{}, failures.Err()
	}

	return {{$n}}{value: raw}, nil
}

// New{{$n}}FromString reads a base-10 identifier.
func New{{$n}}FromString(raw string) ({{$n}}, error) {
	value, err := strconv.ParseInt(raw, 10, 64)
	if err != nil {
		var failures {{.Failures}}
		failures.Add({{q .Field}}, "int", "must be a whole number")

		return {{$n}}{}, failures.Err()
	}

	return New{{$n}}FromInt64(value)
}

// Int64 returns the identifier as the database holds it.
func ({{$r}} {{$n}}) Int64() int64 { return {{$r}}.value }

// String returns the base-10 representation.
func ({{$r}} {{$n}}) String() string { return strconv.FormatInt({{$r}}.value, 10) }

// IsZero reports whether the identifier is unassigned; `json:",omitzero"` asks it.
func ({{$r}} {{$n}}) IsZero() bool { return {{$r}}.value == 0 }

// Equal reports whether both identify the same entity.
func ({{$r}} {{$n}}) Equal(other {{$n}}) bool { return {{$r}} == other }

// MarshalText implements encoding.TextMarshaler, so JSON carries the identifier
// as a string that keeps its precision in a JavaScript client.
func ({{$r}} {{$n}}) MarshalText() ([]byte, error) {
	if {{$r}}.IsZero() {
		return nil, fmt.Errorf("cannot marshal the zero {{$n}}: %w", errors.ErrUnsupported)
	}

	return []byte({{$r}}.String()), nil
}

// UnmarshalText implements encoding.TextUnmarshaler through New{{$n}}FromString.
func ({{$r}} *{{$n}}) UnmarshalText(data []byte) error {
	parsed, err := New{{$n}}FromString(string(data))
	if err != nil {
		return err
	}

	*{{$r}} = parsed

	return nil
}
{{if .SQL}}
// Value implements driver.Valuer; an unassigned identifier is stored as NULL.
func ({{$r}} {{$n}}) Value() (driver.Value, error) {
	if {{$r}}.IsZero() {
		// A nil driver.Value is SQL NULL.
		var null driver.Value

		return null, nil
	}

	return {{$r}}.value, nil
}

// Scan implements sql.Scanner for integer and text columns.
func ({{$r}} *{{$n}}) Scan(src any) error {
	switch source := src.(type) {
	case nil:
		var zero {{$n}}

		*{{$r}} = zero

		return nil
	case int64:
		parsed, err := New{{$n}}FromInt64(source)
		if err != nil {
			return err
		}

		*{{$r}} = parsed

		return nil
	case string:
		return {{$r}}.UnmarshalText([]byte(source))
	case []byte:
		return {{$r}}.UnmarshalText(source)
	default:
		return fmt.Errorf("cannot scan %T into {{$n}}: %w", src, errors.ErrUnsupported)
	}
}
{{end}}
