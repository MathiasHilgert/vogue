{{$n := .Name}}{{$r := .Recv}}
{{range .DocLines}}// {{.}}
{{end}}//
// The value is assigned by the database, so this type has no generator: an
// identifier is either read from a row or a payload, or built from a number the
// database already handed out with New{{$n}}FromInt64.
{{- if .SQL}}
//
//nolint:recvcheck // Scan implements sql.Scanner and needs a pointer receiver.
{{- end}}
type {{$n}} struct{ v int64 }

// New{{$n}}FromInt64 wraps a database-assigned identifier. Identifiers are
// positive by definition, so zero and negative values are rejected rather than
// quietly producing an identifier equal to the zero value.
func New{{$n}}FromInt64(raw int64) ({{$n}}, error) {
	if raw <= 0 {
		var (
			zero {{$n}}
			n    validation.Notification
		)

		n.Reject({{q .Field}}, "positive", "", strconv.FormatInt(raw, 10), "{{.Field}} must be a positive identifier")

		return zero, &n
	}

	return {{$n}}{v: raw}, nil
}

// New{{$n}}FromString reads a base-10 representation of an identifier.
func New{{$n}}FromString(raw string) ({{$n}}, error) {
	v, err := strconv.ParseInt(raw, 10, 64)
	if err != nil {
		var (
			zero {{$n}}
			n    validation.Notification
		)

		n.Reject({{q .Field}}, "int", "", raw, "{{.Field}} must be a whole number")

		return zero, &n
	}

	return New{{$n}}FromInt64(v)
}

// Int64 returns the identifier as the database holds it.
func ({{$r}} {{$n}}) Int64() int64 { return {{$r}}.v }

// String returns the base-10 representation of the identifier.
func ({{$r}} {{$n}}) String() string { return strconv.FormatInt({{$r}}.v, 10) }

// IsZero reports whether the receiver is an unassigned identifier.
func ({{$r}} {{$n}}) IsZero() bool { return {{$r}}.v == 0 }

// Equal reports whether both identifiers refer to the same entity.
func ({{$r}} {{$n}}) Equal(other {{$n}}) bool { return {{$r}}.v == other.v }

// MarshalText implements encoding.TextMarshaler, which encoding/json also
// uses, so the identifier crosses a JSON boundary as a string and keeps its
// full precision in a JavaScript client.
func ({{$r}} {{$n}}) MarshalText() ([]byte, error) { return []byte({{$r}}.String()), nil }

// UnmarshalText implements encoding.TextUnmarshaler through
// New{{$n}}FromString.
func ({{$r}} *{{$n}}) UnmarshalText(data []byte) error {
	parsed, err := New{{$n}}FromString(string(data))
	if err != nil {
		return err
	}

	*{{$r}} = parsed

	return nil
}
{{if .SQL}}
// Value implements driver.Valuer.
func ({{$r}} {{$n}}) Value() (driver.Value, error) { return {{$r}}.v, nil }

// Scan implements sql.Scanner for integer and text columns.
func ({{$r}} *{{$n}}) Scan(src any) error {
	switch value := src.(type) {
	case nil:
		var zero {{$n}}

		*{{$r}} = zero

		return nil
	case int64:
		parsed, err := New{{$n}}FromInt64(value)
		if err != nil {
			return err
		}

		*{{$r}} = parsed

		return nil
	case string:
		return {{$r}}.UnmarshalText([]byte(value))
	case []byte:
		return {{$r}}.UnmarshalText(value)
	default:
		return fmt.Errorf("vogue: cannot scan %T into {{$n}}: %w", src, validation.ErrUnsupportedSource)
	}
}
{{end}}
