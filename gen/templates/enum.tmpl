{{$n := .Name}}{{$r := .Recv}}{{$c := .Catalogue}}{{$k := .CatalogueRecv}}
{{range .DocLines}}// {{.}}
{{end}}//
// Its members are the methods of [{{$c}}], spelled {{$c}}{}.{{(index .Members 0).Method}}(). The zero {{$n}} is no member.
{{- if .SQL}}
//
//nolint:recvcheck // Scan implements sql.Scanner and needs a pointer receiver.
{{- end}}
type {{$n}} struct{ value string }

// {{$c}} is the catalogue of the members of {{$n}}; its zero value is all of it.
type {{$c}} struct{}
{{range .Members}}
// {{.Method}} returns the {{q .Value}} member of {{$n}}.
func ({{$c}}) {{.Method}}() {{$n}} { return {{$n}}{value: {{q .Value}}} }
{{end}}
// All returns every member in declaration order.
func ({{$k}} {{$c}}) All() []{{$n}} {
	return []{{$n}}{
{{range .Members}}		{{$k}}.{{.Method}}(),
{{end}}	}
}

// Parse returns the member whose wire value is raw, or a "oneof" failure.
func ({{$k}} {{$c}}) Parse(raw string) ({{$n}}, error) {
	switch raw {
{{range .Members}}	case {{q .Value}}:
		return {{$k}}.{{.Method}}(), nil
{{end}}	}

	var failures {{.Failures}}
	failures.Add({{q .Field}}, "oneof", {{q .Message}})

	return {{$n}}{}, failures.Err()
}

// String returns the wire value, empty for the zero {{$n}}.
func ({{$r}} {{$n}}) String() string { return {{$r}}.value }

// IsZero reports whether the receiver is no member; `json:",omitzero"` asks it.
func ({{$r}} {{$n}}) IsZero() bool { return {{$r}}.value == "" }

// Equal reports whether both are the same member.
func ({{$r}} {{$n}}) Equal(other {{$n}}) bool { return {{$r}} == other }

// MarshalText implements encoding.TextMarshaler; the zero {{$n}} has no text form.
func ({{$r}} {{$n}}) MarshalText() ([]byte, error) {
	if {{$r}}.IsZero() {
		return nil, fmt.Errorf("cannot marshal the zero {{$n}}: %w", errors.ErrUnsupported)
	}

	return []byte({{$r}}.value), nil
}

// UnmarshalText implements encoding.TextUnmarshaler through {{$c}}.Parse.
func ({{$r}} *{{$n}}) UnmarshalText(data []byte) error {
	parsed, err := {{$c}}{}.Parse(string(data))
	if err != nil {
		return err
	}

	*{{$r}} = parsed

	return nil
}
{{if .SQL}}
// Value implements driver.Valuer; the zero {{$n}} is stored as NULL.
func ({{$r}} {{$n}}) Value() (driver.Value, error) {
	if {{$r}}.IsZero() {
		// A nil driver.Value is SQL NULL.
		var null driver.Value

		return null, nil
	}

	return {{$r}}.value, nil
}

// Scan implements sql.Scanner and rejects a stored value that is no longer a member.
func ({{$r}} *{{$n}}) Scan(src any) error {
	switch source := src.(type) {
	case nil:
		var zero {{$n}}

		*{{$r}} = zero

		return nil
	case string:
		return {{$r}}.UnmarshalText([]byte(source))
	case []byte:
		return {{$r}}.UnmarshalText(source)
	default:
		return fmt.Errorf("cannot scan %T into {{$n}}: %w", src, errors.ErrUnsupported)
	}
}
{{end}}
