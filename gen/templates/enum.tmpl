{{$n := .Name}}{{$r := .Recv}}
{{range .DocLines}}// {{.}}
{{end}}//
// The members are the package-level {{$n}} variables below. The type stays a
// struct with an unexported field so its zero value is not a member: an
// uninitialised {{$n}} reports IsZero and can never be mistaken for a
// meaningful state.
type {{$n}} struct{ v string }

// The members of {{$n}}, in declaration order.
var (
{{range .Members}}	// {{.Const}} is the {{q .Value}} member of {{$n}}.
	{{.Const}} = {{$n}}{v: {{q .Value}}}
{{end}})

// {{$n}}Values returns every member in declaration order. Ranging over it is
// what makes a test exhaustive: a member added to the directive shows up here
// without the test being touched.
func {{$n}}Values() []{{$n}} {
	return []{{$n}}{ {{range $i, $m := .Members}}{{if $i}}, {{end}}{{$m.Const}}{{end}} }
}

// Parse{{$n}} resolves the wire representation of a member.
func Parse{{$n}}(raw string) ({{$n}}, error) {
	switch raw {
{{range .Members}}	case {{q .Value}}:
		return {{.Const}}, nil
{{end}}	}

	var n validation.Notification
	n.Add(validation.FieldError{Field: {{q .Field}}, Rule: "oneof", Param: {{q .MemberParam}}, Value: raw, Message: "{{.Field}} must be one of: {{.MemberList}}"})
	return {{$n}}{}, n.ErrOrNil()
}

// String returns the wire representation of the member, empty for the zero
// value.
func ({{$r}} {{$n}}) String() string { return {{$r}}.v }

// IsZero reports whether the receiver is the zero {{$n}} rather than one of
// its members.
func ({{$r}} {{$n}}) IsZero() bool { return {{$r}}.v == "" }

// Equal reports whether both value objects hold the same member.
func ({{$r}} {{$n}}) Equal(other {{$n}}) bool { return {{$r}}.v == other.v }

// MarshalText implements encoding.TextMarshaler, which is also what
// encoding/json uses, so a member marshals as its wire string.
func ({{$r}} {{$n}}) MarshalText() ([]byte, error) { return []byte({{$r}}.v), nil }

// UnmarshalText implements encoding.TextUnmarshaler through Parse{{$n}}, so an
// unknown member is rejected rather than accepted as a new state.
func ({{$r}} *{{$n}}) UnmarshalText(data []byte) error {
	parsed, err := Parse{{$n}}(string(data))
	if err != nil {
		return err
	}
	*{{$r}} = parsed
	return nil
}

// Value implements driver.Valuer.
func ({{$r}} {{$n}}) Value() (driver.Value, error) { return {{$r}}.v, nil }

// Scan implements sql.Scanner for text columns, rejecting a stored value that
// is no longer a member.
func ({{$r}} *{{$n}}) Scan(src any) error {
	switch value := src.(type) {
	case nil:
		*{{$r}} = {{$n}}{}
		return nil
	case string:
		return {{$r}}.UnmarshalText([]byte(value))
	case []byte:
		return {{$r}}.UnmarshalText(value)
	default:
		return fmt.Errorf("vogue: cannot scan %T into {{$n}}: %w", src, validation.ErrUnsupportedSource)
	}
}
