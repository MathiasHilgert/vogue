{{$n := .Name}}
// Test{{$n}} runs the value-object suite against the examples the directive
// and its rules declare.
func Test{{$n}}(t *testing.T) {
	t.Parallel()

	voguetest.Scalar[{{$n}}, *{{$n}}, {{.InType}}]{
		Field:      {{q .Field}},
		New:        {{.Ctor}},
		Get:        {{or .Get "nil"}},
		FromString: {{or .FromString "nil"}},
		ParseRule:  {{q .ParseRule}},
		Examples:   {{if .Examples}}[]{{.InType}}{ {{- range $i, $e := .Examples}}{{if $i}}, {{end}}{{$e}}{{end -}} }{{else}}nil{{end}},
		Candidates: {{if .Candidates}}[]{{.InType}}{ {{- range $i, $e := .Candidates}}{{if $i}}, {{end}}{{$e}}{{end -}} }{{else}}nil{{end}},
		Rejected: {{if .Cases}}[]voguetest.Rejection[{{.InType}}]{
{{range .Cases}}			{
				Name:  {{q .Name}},
				Input: {{.Lit}},
				Rules: []string{ {{- range $i, $rule := .Rules}}{{if $i}}, {{end}}{{q $rule}}{{end -}} },
			},
{{end}}		}{{else}}nil{{end}},
		Normalized: {{if .Normalizations}}[]voguetest.Normalization[{{.InType}}]{
{{range .Normalizations}}			{
				Name: {{q .Name}},
				Input: {{.In}},
				Out:  {{.Out}},
			},
{{end}}		}{{else}}nil{{end}},
		RefusesFloat: {{.RefusesFloat}},
	}.Run(t)
}
