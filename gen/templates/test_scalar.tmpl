// TestNew{{$n}}_Normalizes proves the normalizers of the directive rewrite the
// value instead of only accepting it.
func TestNew{{$n}}_Normalizes(t *testing.T) {
	t.Parallel()

	// Arrange
	cases := []struct {
		name string
		in   {{.InType}}
		want {{.InType}}
	}{
{{range .Normalizations}}		{name: {{q .Name}}, in: {{.In}}, want: {{.Out}}},
{{end}}	}

	for _, tc := range cases {
		t.Run(tc.name, func(t *testing.T) {
			t.Parallel()

			// Act
			got, err := {{.Ctor}}(tc.in)

			// Assert
			require.NoError(t, err)
			assert.Equal(t, tc.want, got.{{.Accessor}}())
		})
	}
}
{{end}}
