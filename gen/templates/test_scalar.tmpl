// Test{{$n}}_TextRoundTrip proves a marshalled value object unmarshals back to
// an equal one, which is what a JSON boundary does to it.
func Test{{$n}}_TextRoundTrip(t *testing.T) {
	t.Parallel()

	// Arrange
	want, err := {{.Ctor}}({{.ValidLit}})
	require.NoError(t, err)

	// Act
	text, err := want.MarshalText()
	require.NoError(t, err)

	var got {{$n}}
	err = got.UnmarshalText(text)

	// Assert
	require.NoError(t, err)
	assert.True(t, want.Equal(got), "%s did not survive the text round trip", want.String())
}

// Test{{$n}}_SQLRoundTrip proves a stored value object reads back equal.
func Test{{$n}}_SQLRoundTrip(t *testing.T) {
	t.Parallel()

	// Arrange
	want, err := {{.Ctor}}({{.ValidLit}})
	require.NoError(t, err)

	// Act
	stored, err := want.Value()
	require.NoError(t, err)

	var got {{$n}}
	err = got.Scan(stored)

	// Assert
	require.NoError(t, err)
	assert.True(t, want.Equal(got), "%s did not survive the SQL round trip", want.String())
}

// Test{{$n}}_Scan covers the sources Scan accepts and the ones it refuses.
func Test{{$n}}_Scan(t *testing.T) {
	t.Parallel()

	t.Run("a NULL column produces the zero value", func(t *testing.T) {
		t.Parallel()

		// Arrange
		var got {{$n}}

		// Act
		err := got.Scan(nil)

		// Assert
		require.NoError(t, err)
		assert.True(t, got.IsZero())
	})
{{if .InvalidRaw}}
	t.Run("a stored value the rules reject is refused", func(t *testing.T) {
		t.Parallel()

		// Arrange
		var got {{$n}}

		// Act
		err := got.Scan({{q .InvalidRaw}})

		// Assert
		require.Error(t, err)
		assert.True(t, got.IsZero())
	})
{{end}}
{{if .RefusesFloat}}	t.Run("a binary float source is refused", func(t *testing.T) {
		t.Parallel()

		// Arrange
		var got {{$n}}

		// Act
		err := got.Scan(1.5)

		// Assert
		require.Error(t, err)
		assert.Contains(t, err.Error(), "binary float")
		assert.True(t, got.IsZero())
	})

{{end}}	t.Run("an unsupported source is refused", func(t *testing.T) {
		t.Parallel()

		// Arrange
		var got {{$n}}

		// Act
		err := got.Scan(struct{}{})

		// Assert
		require.Error(t, err)
		assert.Contains(t, err.Error(), "cannot scan")
	})
}
{{if .HasParse}}
// TestParse{{$n}} covers the textual entry point of the value object.
func TestParse{{$n}}(t *testing.T) {
	t.Parallel()

	t.Run("reads a valid representation", func(t *testing.T) {
		t.Parallel()

		// Arrange
		want, err := {{.Ctor}}({{.ValidLit}})
		require.NoError(t, err)

		// Act
		got, err := Parse{{$n}}({{.ValidRaw}})

		// Assert
		require.NoError(t, err)
		assert.True(t, want.Equal(got))
	})

	t.Run("rejects a representation that {{.ParseNote}}", func(t *testing.T) {
		t.Parallel()

		// Act
		got, err := Parse{{$n}}("not-a-number")

		// Assert
		require.Error(t, err)
		assert.ErrorIs(t, err, validation.FieldError{Field: {{q .Field}}, Rule: {{q .ParseRule}}})
		assert.True(t, got.IsZero())
	})
}
{{end}}
// Test{{$n}}_IsZero separates the zero value from a validated one.
func Test{{$n}}_IsZero(t *testing.T) {
	t.Parallel()

	// Arrange
	var zero {{$n}}
	built, err := {{.Ctor}}({{.ValidLit}})
	require.NoError(t, err)

	// Act & Assert
	assert.True(t, zero.IsZero())
	assert.False(t, built.IsZero())
	assert.False(t, zero.Equal(built))
}
{{end}}
