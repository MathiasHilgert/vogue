// Scan implements sql.Scanner and validates like the constructor.
func ({{$r}} *{{$n}}) Scan(src any) error {
	switch source := src.(type) {
	case nil:
		var zero {{$n}}

		*{{$r}} = zero

		return nil
	case int64:
		parsed, err := New{{$n}}(source)
		if err != nil {
			return err
		}

		*{{$r}} = parsed

		return nil
	case string:
		return {{$r}}.UnmarshalText([]byte(source))
	case []byte:
		return {{$r}}.UnmarshalText(source)
	default:
		return fmt.Errorf("cannot scan %T into {{$n}}: %w", src, errors.ErrUnsupported)
	}
}
