{{$n := .Name}}{{$r := .Recv}}
{{range .DocLines}}// {{.}}
{{end}}//
// The value is held as an int64 so it survives every database driver and JSON
// number without a widening conversion at the boundary.
{{- if .SQL}}
//
//nolint:recvcheck // Scan implements sql.Scanner and needs a pointer receiver.
{{- end}}
type {{$n}} struct{ value int64 }

// New{{$n}} validates raw and returns the {{$n}} it describes.
//
// Rules are applied in the order they were declared, and every failure is
// collected into one error rather than the first one aborting the rest.
func New{{$n}}(raw int64) ({{$n}}, error) {
{{template "validate" .}}
	return {{$n}}{value: value}, nil
}

// New{{$n}}FromString reads a base-10 representation and validates it. A
// representation that is not a whole number is reported as a failure of the
// "int" rule, so a caller handles it like every other rule.
func New{{$n}}FromString(raw string) ({{$n}}, error) {
	value, err := strconv.ParseInt(raw, 10, 64)
	if err != nil {
		var (
			zero {{$n}}
			notification validation.Notification
		)

		notification.Reject(
			{{q .Field}},
			"int",
			"",
			raw,
			"{{.Field}} must be a whole number",
		)

		return zero, &notification
	}

	return New{{$n}}(value)
}

// Int64 returns the validated value.
func ({{$r}} {{$n}}) Int64() int64 { return {{$r}}.value }

// String returns the base-10 representation of the value.
func ({{$r}} {{$n}}) String() string { return strconv.FormatInt({{$r}}.value, 10) }

// IsZero reports whether the receiver is the zero {{$n}}, which is the only
// {{$n}} that never passed validation.
func ({{$r}} {{$n}}) IsZero() bool { return {{$r}}.value == 0 }

// Equal reports whether both value objects hold the same value.
func ({{$r}} {{$n}}) Equal(other {{$n}}) bool { return {{$r}}.value == other.value }

// MarshalText implements encoding.TextMarshaler. encoding/json uses the text
// codec when a type implements it, so {{$n}} round-trips through JSON without
// a MarshalJSON of its own.
func ({{$r}} {{$n}}) MarshalText() ([]byte, error) { return []byte({{$r}}.String()), nil }

// UnmarshalText implements encoding.TextUnmarshaler, re-running validation so
// no payload can produce a {{$n}} the constructor would have rejected.
func ({{$r}} *{{$n}}) UnmarshalText(data []byte) error {
	parsed, err := New{{$n}}FromString(string(data))
	if err != nil {
		return err
	}

	*{{$r}} = parsed

	return nil
}
{{if .SQL}}
// Value implements driver.Valuer.
func ({{$r}} {{$n}}) Value() (driver.Value, error) { return {{$r}}.value, nil }

// Scan implements sql.Scanner for integer and text columns, re-running
// validation so a row that no longer satisfies the rules surfaces as a
// validation error.
func ({{$r}} *{{$n}}) Scan(src any) error {
	switch source := src.(type) {
	case nil:
		var zero {{$n}}

		*{{$r}} = zero

		return nil
	case int64:
		parsed, err := New{{$n}}(source)
		if err != nil {
			return err
		}

		*{{$r}} = parsed

		return nil
	case string:
		return {{$r}}.UnmarshalText([]byte(source))
	case []byte:
		return {{$r}}.UnmarshalText(source)
	default:
		return fmt.Errorf("vogue: cannot scan %T into {{$n}}: %w", src, validation.ErrUnsupportedSource)
	}
}
{{end}}
