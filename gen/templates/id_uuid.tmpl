{{$n := .Name}}{{$r := .Recv}}
{{range .DocLines}}// {{.}}
{{end}}//
// It wraps a uuid.UUID it does not expose for writing, so an identifier is
// minted, read from text or a row, or zero, and stays a type of its own.
{{- if .SQL}}
//
//nolint:recvcheck // Scan implements sql.Scanner and needs a pointer receiver.
{{- end}}
type {{$n}} struct{ value uuid.UUID }

// New{{$n}} mints {{.MintDoc}}.
func New{{$n}}() ({{$n}}, error) {
	id, err := {{.Mint}}()
	if err != nil {
		return {{$n}}{}, fmt.Errorf("cannot mint {{$n}}: %w", err)
	}

	return {{$n}}{value: id}, nil
}

// New{{$n}}FromString reads any RFC 4122 UUID, not only the version this type
// mints. The nil UUID is refused: it is what an unassigned identifier looks like.
func New{{$n}}FromString(raw string) ({{$n}}, error) {
	id, err := uuid.Parse(raw)
	if err != nil {
		var failures {{.Failures}}
		failures.Add({{q .Field}}, "uuid", "must be a valid UUID")

		return {{$n}}{}, failures.Err()
	}

	if id == uuid.Nil {
		var failures {{.Failures}}
		failures.Add({{q .Field}}, "required", "must not be the nil UUID")

		return {{$n}}{}, failures.Err()
	}

	return {{$n}}{value: id}, nil
}

// UUID returns the identifier as a uuid.UUID.
func ({{$r}} {{$n}}) UUID() uuid.UUID { return {{$r}}.value }

// String returns the canonical text.
func ({{$r}} {{$n}}) String() string { return {{$r}}.value.String() }

// IsZero reports whether the identifier is the nil UUID; `json:",omitzero"` asks it.
func ({{$r}} {{$n}}) IsZero() bool { return {{$r}}.value == uuid.Nil }

// Equal reports whether both identify the same entity.
func ({{$r}} {{$n}}) Equal(other {{$n}}) bool { return {{$r}} == other }

// MarshalText implements encoding.TextMarshaler; the zero {{$n}} has no text form.
func ({{$r}} {{$n}}) MarshalText() ([]byte, error) {
	if {{$r}}.IsZero() {
		return nil, fmt.Errorf("cannot marshal the zero {{$n}}: %w", errors.ErrUnsupported)
	}

	return []byte({{$r}}.value.String()), nil
}

// UnmarshalText implements encoding.TextUnmarshaler through New{{$n}}FromString.
func ({{$r}} *{{$n}}) UnmarshalText(data []byte) error {
	parsed, err := New{{$n}}FromString(string(data))
	if err != nil {
		return err
	}

	*{{$r}} = parsed

	return nil
}
{{if .SQL}}
// Value implements driver.Valuer, storing the canonical text; an unassigned
// identifier is stored as NULL.
func ({{$r}} {{$n}}) Value() (driver.Value, error) {
	if {{$r}}.IsZero() {
		// A nil driver.Value is SQL NULL.
		var null driver.Value

		return null, nil
	}

	return {{$r}}.value.String(), nil
}

// Scan implements sql.Scanner for uuid and text columns.
func ({{$r}} *{{$n}}) Scan(src any) error {
	switch source := src.(type) {
	case nil:
		var zero {{$n}}

		*{{$r}} = zero

		return nil
	case string:
		return {{$r}}.UnmarshalText([]byte(source))
	case []byte:
		return {{$r}}.scanBytes(source)
	default:
		return fmt.Errorf("cannot scan %T into {{$n}}: %w", src, errors.ErrUnsupported)
	}
}

// scanBytes reads a uuid column, which a driver hands back as text or as 16 raw bytes.
func ({{$r}} *{{$n}}) scanBytes(raw []byte) error {
	const rawLength = 16

	if len(raw) != rawLength {
		return {{$r}}.UnmarshalText(raw)
	}

	id, err := uuid.FromBytes(raw)
	if err != nil {
		return fmt.Errorf("cannot scan %d bytes into {{$n}}: %w", len(raw), err)
	}

	// Through the text form, so the nil UUID is refused here as everywhere else.
	return {{$r}}.UnmarshalText([]byte(id.String()))
}
{{end}}
