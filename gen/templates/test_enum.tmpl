{{$n := .Name}}
// TestParse{{$n}} resolves every declared member and refuses everything else.
func TestParse{{$n}}(t *testing.T) {
	t.Parallel()

	// Arrange
	cases := []struct {
		name    string
		in      string
		want    {{$n}}
		wantErr bool
	}{
{{range .Members}}		{name: "parses {{.Value}}", in: {{q .Value}}, want: {{.Const}}},
{{end}}		{name: "rejects a value that is not a member", in: "not-a-member", wantErr: true},
		{name: "rejects the empty string", in: "", wantErr: true},
	}

	for _, tc := range cases {
		t.Run(tc.name, func(t *testing.T) {
			t.Parallel()

			// Act
			got, err := Parse{{$n}}(tc.in)

			// Assert
			if tc.wantErr {
				require.Error(t, err)
				assert.ErrorIs(t, err, validation.FieldError{Field: {{q .Field}}, Rule: "oneof", Param: {{q .MemberParam}}})
				assert.True(t, got.IsZero())
				return
			}
			require.NoError(t, err)
			assert.Equal(t, tc.want, got)
			assert.Equal(t, tc.in, got.String())
		})
	}
}

// Test{{$n}}Values pins the member set and its order: a member added to or
// removed from the directive fails here first.
func Test{{$n}}Values(t *testing.T) {
	t.Parallel()

	// Arrange
	want := []string{ {{range $i, $m := .Members}}{{if $i}}, {{end}}{{q $m.Value}}{{end}} }

	// Act
	got := {{$n}}Values()

	// Assert
	require.Len(t, got, len(want))
	for i, member := range got {
		assert.Equal(t, want[i], member.String())
		assert.False(t, member.IsZero())
	}
}

// Test{{$n}}_RoundTrip proves every member survives both boundaries it
// crosses, the text codec and the database.
func Test{{$n}}_RoundTrip(t *testing.T) {
	t.Parallel()

	for _, want := range {{$n}}Values() {
		t.Run(want.String(), func(t *testing.T) {
			t.Parallel()

			// Act
			text, err := want.MarshalText()
			require.NoError(t, err)

			var fromText {{$n}}
			require.NoError(t, fromText.UnmarshalText(text))

			stored, err := want.Value()
			require.NoError(t, err)

			var fromSQL {{$n}}
			err = fromSQL.Scan(stored)

			// Assert
			require.NoError(t, err)
			assert.True(t, want.Equal(fromText))
			assert.True(t, want.Equal(fromSQL))
		})
	}
}

// Test{{$n}}_Scan covers the sources Scan accepts and the ones it refuses.
func Test{{$n}}_Scan(t *testing.T) {
	t.Parallel()

	t.Run("a NULL column produces the zero value", func(t *testing.T) {
		t.Parallel()

		// Arrange
		var got {{$n}}

		// Act
		err := got.Scan(nil)

		// Assert
		require.NoError(t, err)
		assert.True(t, got.IsZero())
	})

	t.Run("a stored value that is no longer a member is refused", func(t *testing.T) {
		t.Parallel()

		// Arrange
		var got {{$n}}

		// Act
		err := got.Scan("not-a-member")

		// Assert
		require.Error(t, err)
		assert.True(t, got.IsZero())
	})

	t.Run("an unsupported source is refused", func(t *testing.T) {
		t.Parallel()

		// Arrange
		var got {{$n}}

		// Act
		err := got.Scan(struct{}{})

		// Assert
		require.Error(t, err)
		assert.Contains(t, err.Error(), "cannot scan")
	})
}

// Test{{$n}}_IsZero proves the zero value is not one of the members, which is
// the whole point of generating an enum as a struct.
func Test{{$n}}_IsZero(t *testing.T) {
	t.Parallel()

	// Arrange
	var zero {{$n}}

	// Act & Assert
	assert.True(t, zero.IsZero())
	assert.Empty(t, zero.String())
	for _, member := range {{$n}}Values() {
		assert.False(t, zero.Equal(member), "the zero value must not equal %s", member.String())
	}
}
