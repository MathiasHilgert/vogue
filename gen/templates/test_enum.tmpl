{{$n := .Name}}
// Test{{$n}} pins the members of {{$n}} and runs the enum suite over them.
func Test{{$n}}(t *testing.T) {
	t.Parallel()

	voguetest.Enum[{{$n}}, *{{$n}}]{
		Field: {{q .Field}},
		All:   {{.Catalogue}}{}.All(),
		Parse: {{.Catalogue}}{}.Parse,
		Want: []string{
{{range .Members}}			{{q .Value}},
{{end}}		},
	}.Run(t)
}
