{{$n := .Name}}
// Test{{$n}} runs the identifier suite: fresh UUIDv{{.Version}} mints, and any
// RFC 4122 UUID read back.
func Test{{$n}}(t *testing.T) {
	t.Parallel()

	voguetest.UUID[{{$n}}, *{{$n}}]{
		Field:      {{q .Field}},
		New:        New{{$n}},
		FromString: New{{$n}}FromString,
		Version:    {{.Version}},
	}.Run(t)
}
