{{template "validate" .}}
// New{{$n}}FromString reads an exact decimal number and validates it.
func New{{$n}}FromString(raw string) ({{$n}}, error) {
	value, err := decimal.Parse(raw)
	if err != nil {
		var failures {{.Failures}}
		failures.Add({{q .Field}}, "decimal", "must be an exact decimal number")

		return {{$n}}{}, failures.Err()
	}

	return New{{$n}}(value)
}

// Decimal returns the validated value.
func ({{$r}} {{$n}}) Decimal() decimal.Decimal { return {{$r}}.value }

// String returns the canonical text, which keeps the scale: 1.50 stays "1.50".
func ({{$r}} {{$n}}) String() string { return {{$r}}.value.String() }

// IsZero reports whether the receiver was never constructed; `json:",omitzero"` asks it.
func ({{$r}} {{$n}}) IsZero() bool { return !{{$r}}.set }

// Equal reports whether both hold the same number, so 1.5 equals 1.50.
func ({{$r}} {{$n}}) Equal(other {{$n}}) bool {
	return {{$r}}.set == other.set && {{$r}}.value.Cmp(other.value) == 0
}

// MarshalText implements encoding.TextMarshaler; the zero {{$n}} has no text form.
func ({{$r}} {{$n}}) MarshalText() ([]byte, error) {
	if {{$r}}.IsZero() {
		return nil, fmt.Errorf("cannot marshal the zero {{$n}}: %w", errors.ErrUnsupported)
	}

	return []byte({{$r}}.value.String()), nil
}

// UnmarshalText implements encoding.TextUnmarshaler and validates like the constructor.
func ({{$r}} *{{$n}}) UnmarshalText(data []byte) error {
	parsed, err := New{{$n}}FromString(string(data))
	if err != nil {
		return err
	}

	*{{$r}} = parsed

	return nil
}
{{if .SQL}}
// Value implements driver.Valuer, storing the canonical text, which a numeric
// column keeps digit for digit. The zero {{$n}} is stored as NULL.
func ({{$r}} {{$n}}) Value() (driver.Value, error) {
	if !{{$r}}.set {
		// A nil driver.Value is SQL NULL.
		var null driver.Value

		return null, nil
	}

	return {{$r}}.value.String(), nil
}

// Scan implements sql.Scanner and validates like the constructor. A binary
// float is refused: it has already lost digits, so a driver must hand numeric
// columns back as text.
func ({{$r}} *{{$n}}) Scan(src any) error {
	switch source := src.(type) {
	case nil:
		var zero {{$n}}

		*{{$r}} = zero

		return nil
	case string:
		return {{$r}}.UnmarshalText([]byte(source))
	case []byte:
		return {{$r}}.UnmarshalText(source)
	case int64:
		return {{$r}}.scanInt64(source)
	case float64, float32:
		return fmt.Errorf("cannot scan the binary float %T into {{$n}}: %w", src, errors.ErrUnsupported)
	default:
		return fmt.Errorf("cannot scan %T into {{$n}}: %w", src, errors.ErrUnsupported)
	}
}

// scanInt64 reads a whole number handed back by an integer column.
func ({{$r}} *{{$n}}) scanInt64(number int64) error {
	whole, err := decimal.New(number, 0)
	if err != nil {
		return fmt.Errorf("cannot scan %d into {{$n}}: %w", number, err)
	}

	parsed, err := New{{$n}}(whole)
	if err != nil {
		return err
	}

	*{{$r}} = parsed

	return nil
}
