{{/*
The body every validating constructor shares: the result that stays zero unless
every rule passes, the failures, the constants the rules declared, the rules in
directive order and the way out. The template is rendered with the voView of
the value object.
*/}}
{{define "validate"}}	var {{.Recv}} {{.Name}} // stays zero unless every rule passes
	var failures {{.Failures}}
{{range .Locals}}
	{{.}}
{{end}}
	value := raw
{{range .Steps}}{{if .Normalize}}	{{.Code}}
{{else}}	if {{.Failed}} {
		failures.Add({{q .Field}}, {{q .Rule}}, {{q .Message}})
{{if .Halt}}
		return {{$.Recv}}, failures.Err()
{{end}}	}
{{end}}{{end}}
	err := failures.Err()
	if err != nil {
		return {{.Recv}}, err
	}

	return {{.Name}}{value: value, set: true}, nil
}
{{end}}

{{/*
The unexported methods the rules of a value object asked for, written after
its exported ones. The receiver is unnamed: a check reads nothing from it.
*/}}
{{define "rulemethods"}}{{range .Methods}}
// {{.Name}} implements the {{.Rule}} rule of New{{$.Name}}.
{{- if .Long}}
//
//nolint:funlen // the body lists data, every name the rule accepts, not logic.
{{- end}}
func ({{$.Name}}) {{.Name}}(value {{.ParamType}}) bool {
{{.Body}}
}
{{end}}{{end}}
