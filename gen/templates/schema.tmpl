{{define "schema"}}{{with .Schema}}
// JSONSchema returns the JSON Schema of the text {{$.Name}} marshals to.
func ({{$.Name}}) JSONSchema() map[string]any {
{{- if .FromMembers}}
	members := {{$.Catalogue}}{}.All()
	values := make([]string, len(members))
	for index, member := range members {
		values[index] = member.String()
	}
{{end}}
{{- if .Consts}}
	const (
{{range .Consts}}		{{.}}
{{end}}	)
{{end}}
	return map[string]any{
{{range .Entries}}		{{q .Key}}: {{.Value}},
{{end}}	}
}
{{end}}{{end}}
